# YouTube Chat Bot environment configuration
# Rename this file to ".env" before running the bot.
# NEVER commit the actual .env file with sensitive data to your repository!

# Contest Settings
CORRECT_PRICE=60.56
MAX_ATTEMPTS=3
LIVE_DURATION=3
# Boolean: Enable extra discount for closest guess if no exact winner (true/false)
# IMPORTANT: Use lowercase only! "TRUE", "1", "yes" will NOT work.
EXTRA_DISCOUNT_FOR_THE_NEAREST=false

# Features
# Boolean: Enable comprehensive logging system (true/false)
# IMPORTANT: Use lowercase only! "TRUE", "1", "yes" will NOT work.
ENABLE_LOGS=true

# File Paths
LOGS_DIR=logs
TOKEN_PATH=token.json
CLIENT_SECRET_PATH=client_secret.json

# Language & Messages
# Available options:
#   messages/messages.json           (🇬🇧 English)
#   messages/messages-italian.json   (🇮🇹 Italian)
#   messages/messages-russian.json   (🇷🇺 Russian)
#   messages/messages-cinese.json    (🇨🇳 Chinese)
#   messages/messages-arabo.json     (🇸🇦 Arabic)
MESSAGES_FILE=messages/messages-italian.json

# Polling Configuration (milliseconds)
MIN_POLLING=5000
MID_POLLING=10000
MAX_POLLING=30000
MESSAGE_DELAY=2000
POLL_ERROR_RETRY=10000

# Traffic Thresholds for Dynamic Polling
HIGH_TRAFFIC_THRESHOLD=10
MEDIUM_TRAFFIC_THRESHOLD=2

# API Retry Configuration
# Number of retry attempts for failed YouTube API calls (recommended: 3-5)
API_RETRY_ATTEMPTS=3
# Base delay in milliseconds between retry attempts (recommended: 1000-2000)
API_RETRY_DELAY=1000

# Display and Timing Configuration (optional)
# Maximum number of exhausted users to display in periodic announcements
MAX_USERS_DISPLAY=10
# Multiplier for final message delays (MESSAGE_DELAY * this value)
FINAL_MESSAGE_DELAY_MULTIPLIER=3

# Log File Names (optional - defaults are fine)
DISCARDS_LOG_FILENAME=discarded_attempts.log
LOG_ATTEMPTS_SUCCESS_FILENAME=valid_attempts.log
ERROR_STARTING_LOG_FILENAME=startup_errors.json
ATTEMPTS_EXHAUSTED_LOG_FILENAME=exhausted_attempts.log
PARTICIPANTS_LOG_FILENAME=participants.log
BOT_RESPONSES_LOG_FILENAME=bot_responses.log
CONSOLE_OUTPUT_LOG_FILENAME=console_output.log

# Announcement Settings
# Legacy setting (kept for backward compatibility)
# Periodic Announcements for Exhausted Users
# Boolean: Enable periodic announcements of users who exhausted their attempts (true/false)
# IMPORTANT: Use lowercase only! "TRUE", "1", "yes" will NOT work.
PERIODIC_EXHAUSTED_ANNOUNCEMENTS=true
# Interval in seconds for periodic announcements (recommended: 30-60 seconds)
PERIODIC_ANNOUNCEMENT_INTERVAL=45

# Extra Discount Thresholds - JSON format
# Default configuration (can be customized)
EXTRADISCOUNT_THRESHOLDS=[{"min":0,"max":1,"discount":80},{"min":1,"max":2,"discount":70},{"min":2,"max":"LIVE_DURATION_MINUTES","discount":60}]

# Alternative examples (comment out the active line above and uncomment one below):
# EXTRADISCOUNT_THRESHOLDS=[{"min":0,"max":1,"discount":85},{"min":2,"max":"LIVE_DURATION_MINUTES","discount":60}]
# EXTRADISCOUNT_THRESHOLDS=[{"min":0,"max":1,"discount":90},{"min":2,"max":2,"discount":75},{"min":3,"max":"LIVE_DURATION_MINUTES","discount":60}]

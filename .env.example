# YouTube Chat Bot environment configuration
# Rename this file to ".env" before running the bot.
# NEVER commit the actual .env file with sensitive data to your repository!

CORRECT_PRICE=****
MAX_ATTEMPTS=****
LIVE_DURATION=****
EXTRA_DISCOUNT_FOR_THE_NEAREST=true
ENABLE_LOGS=true
LOGS_DIR=****
TOKEN_PATH=YOUR_TOKEN_PATH.json
CLIENT_SECRET_PATH=YOUR_CLIENT_SECRET_PATH.json
MIN_POLLING=3000
MID_POLLING=10000
MAX_POLLING=30000
MESSAGE_DELAY=1000
POLL_ERROR_RETRY=10000
DISCARDS_LOG_FILENAME=****
LOG_ATTEMPTS_SUCCESS_FILENAME=****
ERROR_STARTING_LOG_FILENAME=****
ATTEMPTS_EXHAUSTED_LOG_FILENAME=****

# Esempio di configurazione ambiente per il bot YouTube Chat
# Rinomina questo file in ".env" prima di avviare il bot.
# Non committare mai il vero file .env con dati sensibili!

PREZZO_GIUSTO=60.56
MAX_TENTATIVI=10
DURATA_LIVE=30
EXTRASCONTO_AL_PIU_VICINO=true
ENABLE_LOGS=true
SCARTI_LOG_FILE=logs/tentativi_scartati.log
LOG_TENTATIVI_OK_FILE=logs/tentativi_ok.log
